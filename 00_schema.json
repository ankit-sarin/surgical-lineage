{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Surgical Lineage Edge - V3.1 Institutional Hierarchy",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "source_node": {
        "type": "string"
      },
      "source_node_type": {
        "enum": [
          "person",
          "institution",
          "society"
        ]
      },
      "target_node": {
        "type": "string"
      },
      "target_node_type": {
        "enum": [
          "person",
          "institution",
          "society"
        ]
      },
      "edge_type": {
        "enum": [
          "direct_training",
          "observational_study",
          "institutional_founder",
          "institutional_succession",
          "institutional_parent",
          "society_founder",
          "governance_leadership",
          "programmatic_accreditation",
          "residency_at"
        ]
      },
      "start_year": {
        "type": "integer"
      },
      "end_year": {
        "type": [
          "integer",
          "null"
        ]
      },
      "temporal_range": {
        "type": "string"
      },
      "evidence_citation": {
        "type": "string"
      },
      "evidence_type": {
        "$comment": "society_verified was removed pending real society-sourced data. It was added speculatively in commit 1ed22d1 (V17 schema hardening) for a Fellowship Council data-sharing workstream that is now unsequenced, and zero edges ever used it; leaving an unused tier invites mis-tagging that would degrade its credentialing-body meaning. Re-add it in the same commit as the first genuine society-sourced edge, when the data shape is known. Tier order: PMID > DOI > institutional_archive.",
        "enum": [
          "PMID",
          "DOI",
          "institutional_archive"
        ]
      },
      "evidence_locator": {
        "type": "string"
      },
      "confidence": {
        "enum": [
          "high",
          "moderate",
          "low"
        ]
      },
      "notes": {
        "type": "string"
      }
    },
    "required": [
      "source_node",
      "source_node_type",
      "target_node",
      "target_node_type",
      "edge_type",
      "start_year",
      "end_year",
      "temporal_range",
      "evidence_citation",
      "evidence_type",
      "evidence_locator",
      "confidence"
    ]
  }
}